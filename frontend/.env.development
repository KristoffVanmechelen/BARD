VITE_DEV_MODE=true

# Unused while VITE_DEV_MODE=true (apiClient bypasses MSAL entirely and
# uses the X-Dev-Identity-Role header instead), but MsalProvider is still
# mounted so these must be syntactically valid, non-empty placeholder
# values to avoid a construction-time error.
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
