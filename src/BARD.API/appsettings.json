{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BardDatabase": "Server=(local);Database=BardDb;Trusted_Connection=True;TrustServerCertificate=True;",
    "AzureBlobStorage": "UseDevelopmentStorage=true"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<set-per-environment>",
    "ClientId": "<set-per-environment>",
    "Audience": "<set-per-environment>"
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:5173" ]
  },
  "MatchThresholds": {
    "AutoMatchMin": 95.0,
    "LikelyMatchMin": 80.0
  },
  "ScoringWeights": {
    "InvoiceNumber": 0.35,
    "Quantity": 0.20,
    "ExciseCode": 0.20,
    "Description": 0.15,
    "DestinationCountry": 0.10
  },
  "BusinessRules": {
    "ExciseCodeMismatchIsHardBlock": true,
    "QuantityTolerancePct": 0.0,
    "DescriptionFuzzyFloor": 40,
    "RefundDeadlineMonths": 12,
    "ClassificationConfidenceFloor": 0.4
  },
  "Ocr": {
    "Engine": "Tesseract",
    "MinTextCharsPerPage": 40,
    "Dpi": 300,
    "TessDataPath": "./tessdata",
    "Language": "eng+nld+fra+deu"
  },
  "AiAssist": {
    "Enabled": true,
    "AutoTrigger": false,
    "Model": "gpt-4o-mini",
    "MaxRetries": 2,
    "TimeoutSeconds": 30
  },
  "AzureOpenAi": {
    "Endpoint": "<set-per-environment>",
    "ApiKey": "<set-per-environment-use-user-secrets-or-key-vault>"
  },
  "DocumentProcessing": {
    "AliasesFilePath": "DocumentProcessing/Data/aliases.json"
  }
}
